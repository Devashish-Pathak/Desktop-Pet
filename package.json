{
  "name": "desktop-pet",
  "version": "0.1.0",
  "description": "A Windows desktop pet that lives on top of your screen and reacts to your mouse.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "face-api.js": "^0.22.2"
  },
  "build": {
    "appId": "com.rsncontent.desktoppet",
    "productName": "Desktop Pet",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*"
    ]
  }
}
